{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sutrakan",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "worker/index.js",
  "vars": {
    "ADMIN_USERNAME": "Talitom"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ADMIN_SESSIONS",
        "class_name": "AdminSessions"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-admin-sessions",
      "new_sqlite_classes": [
        "AdminSessions"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "16014701",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "16014702",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "LOGIN_ACCOUNT_LIMITER",
      "namespace_id": "16014703",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
